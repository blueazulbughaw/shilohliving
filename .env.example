DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# 32+ random characters; the app refuses to start without it
SECRET_KEY=
JWT_EXPIRES_HOURS=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SUPPORT_EMAIL=
APP_URL=

# Landlord sign-up: invite (needs an invite code from the admin) or open (anyone)
SIGNUP_MODE=invite
# Free days for a new landlord before changes need a subscription
TRIAL_DAYS=7
# Shown to landlords whose trial ended, e.g. "₱499/month. GCash 0917 000 0000 (Juan D.), then message Support."
SUBSCRIPTION_PAY_INFO=

# Cloudinary cloud name that uploads must come from
CLOUDINARY_CLOUD=

# Web Push (phone notifications). Generate a P-256 key pair (base64url); empty = push off
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@shilohliving.app
