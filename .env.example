DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# 32+ random characters; the app refuses to start without it
SECRET_KEY=
JWT_EXPIRES_HOURS=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SUPPORT_EMAIL=
APP_URL=

# Landlord sign-up: open (anyone, the default) or invite (needs an invite code from the admin)
SIGNUP_MODE=open
# Free days for a new landlord before changes need a subscription
TRIAL_DAYS=7
# How landlords pay you, e.g. "₱299/month. GCash 0917 000 0000 (Juan D.), then message Support."
# Leave empty and nobody is charged or blocked (trials are tracked but not enforced).
SUBSCRIPTION_PAY_INFO=
# Hours from UTC for reminder days and times (8 = Philippines). Optional.
APP_UTC_OFFSET=8

# Web Push (phone notifications). Generate a P-256 key pair (base64url); empty = push off
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@shilohliving.app
